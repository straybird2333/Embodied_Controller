# Copy to /etc/roboicl/policy-gateway.env on the simulator host.
# The gateway relays authenticated RPC frames and does not read LLM credentials.
ROBOICL_POLICY_GATEWAY_HOST=127.0.0.1
ROBOICL_POLICY_GATEWAY_PORT=8765
ROBOICL_POLICY_GATEWAY_MAX_WORKERS=8
ROBOICL_POLICY_GATEWAY_STATE=/home/lfy/.local/state/roboicl/policy-gateway
ROBOICL_POLICY_TICKET_SECRET_FILE=/etc/roboicl/policy-ticket.key
