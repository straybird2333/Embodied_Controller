# Copy to /etc/roboicl/remote-api.env and replace deployment-specific values.
# Do not commit the resulting file.
ROBOICL_API_HOST=127.0.0.1
ROBOICL_API_PORT=8080
ROBOICL_API_STATE_DIR=/home/lfy/.local/state/roboicl/api
ROBOICL_API_GPUS=0,1,2,3,4,5,6,7
ROBOICL_API_MAX_PARALLEL=8
ROBOICL_API_MAX_QUEUE=8
ROBOICL_API_CREATE_RATE_PER_MIN=40
ROBOICL_API_MAX_RUN_SECONDS=7200
ROBOICL_API_RETENTION_DAYS=7
ROBOICL_API_LOG_MAX_BYTES=10485760
ROBOICL_ACCESS_KEY_FILE=/etc/roboicl/access-keys
ROBOICL_POLICY_TICKET_SECRET_FILE=/etc/roboicl/policy-ticket.key
ROBOICL_POLICY_WSS_URL=wss://roboicl.example.net/session
ROBOICL_DATA_ROOT=/data1/lfy/Robbot/data
ROBOICL_RESULTS_ROOT=/data1/lfy/Robbot/results
ROBOICL_SIM_PYTHON=/home/lfy/.conda/envs/roboicl-sim/bin/python
ROBOICL_POLICY_PYTHON=/home/lfy/.conda/envs/roboicl-policy/bin/python
ROBOICL_PROFILE_DIR=/home/lfy/.config/roboicl
OMNI_KIT_ACCEPT_EULA=YES
