[Unit]
Description=RoboICL remote simulation control API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lfy
Group=lfy
WorkingDirectory=/data1/lfy/Robbot
EnvironmentFile=/etc/roboicl/remote-api.env
ExecStart=/home/lfy/.conda/envs/roboicl-policy/bin/python -m roboicl.service
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
